mainmodule HapiKernelLaunch {
  readonly int gLeagueSize;
  readonly int gTeamSize;

  mainchare Main {
    entry Main(CkArgMsg* msg);
    entry void stopLaunches();
    entry [reductiontarget] void onReduction(CkReductionMsg* msg);
  };

  array [1D] BenchmarkChare {
    entry BenchmarkChare();
    entry void start();
    entry void launchNext();
    entry void stop();
  };
};
